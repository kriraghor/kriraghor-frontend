# Runtime config (ADR-003). These are read by the server and served to the browser through /env.js.
# Only non-secret values belong here; the allow-list is src/lib/env.ts.
# Defaults point at the backend running locally with `npm run dev` (API :4000, realtime :4001) .
API_URL=http://localhost:4000/api/v1
REALTIME_URL=http://localhost:4001
WEB_URL=http://localhost:3000
ESPORTS_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
VENDOR_URL=http://localhost:3002
COOKIE_PREFIX=kg
GOOGLE_CLIENT_ID=
APP_ENV=local
# Server components only (inside the cluster): http://backend-api.kriraghor.svc.cluster.local/api/v1
INTERNAL_API_URL=http://localhost:4000/api/v1
